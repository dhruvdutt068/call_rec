## ==============================================================================
## Template: Callog Secrets & Credentials Configuration
## Copy this file to `secrets.properties` in the project root and fill in your keys.
## `secrets.properties` is ignored by git and will never be committed.
## ==============================================================================

# Supabase Development Environment
supabase.dev.url=https://your-dev-project.supabase.co
supabase.dev.anon_key=your_dev_anon_key_here

# Supabase Production Environment
supabase.prod.url=https://your-prod-project.supabase.co
supabase.prod.anon_key=your_prod_anon_key_here

# Firebase Development Environment
firebase.dev.project_id=your_dev_firebase_project_id
firebase.dev.api_key=your_dev_firebase_api_key
firebase.dev.app_id=your_dev_firebase_app_id
firebase.dev.storage_bucket=your_dev_firebase_storage_bucket
firebase.dev.gcm_sender_id=your_dev_firebase_gcm_sender_id
firebase.dev.database_url=https://your-dev-project-default-rtdb.firebaseio.com

# Firebase Production Environment
firebase.prod.project_id=your_prod_firebase_project_id
firebase.prod.api_key=your_prod_firebase_api_key
firebase.prod.app_id=your_prod_firebase_app_id
firebase.prod.storage_bucket=your_prod_firebase_storage_bucket
firebase.prod.gcm_sender_id=your_prod_firebase_gcm_sender_id
firebase.prod.database_id=call-logs
